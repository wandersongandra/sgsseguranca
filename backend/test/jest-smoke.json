{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.smoke-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^uuid$": "<rootDir>/../test/uuid-cjs.js",
    "^puppeteer$": "<rootDir>/../test/puppeteer-cjs-shim.js"
  },
  "testEnvironment": "node"
}
