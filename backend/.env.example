# ---------------------------------
# Core Application Configuration
# ---------------------------------
# ATENÇÃO: este arquivo é para DESENVOLVIMENTO LOCAL.
# Produção deve usar variáveis no provedor (Vultr/Coolify) e/ou `backend/.env.production.example`.
# NUNCA copie valores padrão (ex.: DATABASE_PASSWORD=postgres, DATABASE_SSL=false) para produção.
# DEV ONLY: os exemplos abaixo existem apenas para subir ambiente local com PostgreSQL próprio.
#
# Environment: 'development', 'production', or 'test'
NODE_ENV=development
# Port to run the application on
PORT=3001

# Thread pool do libuv — DEVE ser definido no ambiente do processo antes de iniciar Node.
# Aumentar evita fila de bcrypt/argon2 sob carga concorrente.
# Em instâncias pequenas, valores muito altos podem aumentar uso de memória.
# Recomendado inicial: 16 (suba gradualmente conforme CPU/RAM disponível).
UV_THREADPOOL_SIZE=16

# ---------------------------------
# Security & JWT Configuration
# ---------------------------------
# CRÍTICO: JWT_SECRET e JWT_REFRESH_SECRET devem ter no mínimo 64 caracteres em produção.
# Gere cada secret com: openssl rand -hex 32
# JWT_SECRET e JWT_REFRESH_SECRET devem ser DIFERENTES entre si.
# Nunca use os valores de exemplo abaixo em produção.
JWT_SECRET=substitua_por_saida_de_openssl_rand_hex_32_minimo_64_chars
API_PUBLIC_URL=
# Chave de corte: quando false, `public.users.password` deixa de ser a fonte canônica.
# O backend continua aceitando `/auth/login`, `/auth/change-password` e `/auth/confirm-password`,
# mas valida a senha contra `auth.users` e mantém apenas um shadow hash local.
LEGACY_PASSWORD_AUTH_ENABLED=true
JWT_REFRESH_SECRET=substitua_por_outro_valor_de_openssl_rand_hex_32_diferente_do_jwt_secret
# Chave HMAC exclusiva para timestamp de assinaturas; nunca reutilize JWT_SECRET.
# Obrigatória fora de development/test. Gere com: openssl rand -hex 32
SIGNATURE_TIMESTAMP_SECRET=
# Emissor e audiência do token JWT — obrigatórios em produção.
# Em produção: JWT_ISSUER deve ser a URL pública da API; JWT_AUDIENCE o identificador do app.
JWT_ISSUER=https://api.seu-dominio.com.br
JWT_AUDIENCE=sgs-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_TTL=30d
# Criptografia de campos sensíveis em repouso (CPF, dados médicos)
FIELD_ENCRYPTION_ENABLED=true
# 32 bytes em UTF-8, base64 ou 64 chars hex
FIELD_ENCRYPTION_KEY=
# Chave dedicada para hash determinístico de lookup. Use valor secreto próprio em produção.
FIELD_ENCRYPTION_HASH_KEY=
# Chave HMAC exclusiva dos pseudônimos de logs de segurança (mín. 32 chars).
# Gere separadamente com: openssl rand -hex 32
SECURITY_AUDIT_HMAC_KEY=
# Variáveis legadas ainda aceitas para compatibilidade:
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRATION=30d

# Hardening opcional: vincular refresh token ao User-Agent
# Valores: none | ua
REFRESH_BINDING=none

# MFA (TOTP)
MFA_ENABLED=true
MFA_ISSUER=SGS Seguranca
# Se vazio, fallback para JWT_SECRET
MFA_JWT_SECRET=
# Obrigatória em produção quando MFA_ENABLED=true
# 32 bytes em UTF-8, base64 ou 64 chars hex
MFA_TOTP_ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_MFA_KEY
MFA_LOGIN_CHALLENGE_TTL_SECONDS=300
MFA_BOOTSTRAP_TTL_SECONDS=900
MFA_STEP_UP_TTL_SECONDS=300
MFA_MAX_CHALLENGE_ATTEMPTS=5
# Admin empresa opcional/faseado; ADMIN_GERAL continua obrigatório
ADMIN_GERAL_MFA_REQUIRED=true
ADMIN_EMPRESA_MFA_REQUIRED=false
ADMIN_EMPRESA_MFA_ENFORCEMENT_DATE=
ADMIN_EMPRESA_STEP_UP_PASSWORD_FALLBACK_ENABLED=true

# Argon2 tuning (segurança x capacidade)
# Defaults atuais equilibram segurança com estabilidade sob concorrência.
# Para endurecer em instâncias maiores, aumente gradualmente MEMORY/TIME.
PASSWORD_ARGON2_MEMORY_COST_KIB=19456
PASSWORD_ARGON2_TIME_COST=2
PASSWORD_ARGON2_PARALLELISM=1
# Limite global de concorrência para hash/verify de senha.
# Evita pico de memória e kill do processo sob rajadas de login.
PASSWORD_HASH_MAX_CONCURRENCY=8
# Ajustes finos (opcional): separar concorrência de escrita (hash) e leitura (verify).
# Em picos de login, aumentar VERIFY ajuda a reduzir fila sem elevar custo de rotas de escrita.
PASSWORD_HASH_WRITE_MAX_CONCURRENCY=8
PASSWORD_VERIFY_MAX_CONCURRENCY=8

# ---------------------------------
# Database (PostgreSQL) Configuration
# ---------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
# DEV ONLY - NUNCA usar este valor padrão em produção.
DATABASE_PASSWORD=postgres
DATABASE_NAME=minha-api
# SECURITY: Em produção, OBRIGATÓRIO definir DATABASE_SSL=true e DATABASE_SSL_CA.
# DATABASE_SSL=false expõe a conexão a ataques de intercepção (MITM).
# DEV ONLY: manter false apenas para banco local sem TLS.
# Providencie o CA certificate do provedor (Railway/Neon/RDS) como string Base64.
DATABASE_SSL=false
# PRODUÇÃO: DATABASE_SSL=true
DATABASE_SSL_ALLOW_INSECURE=false
DATABASE_SSL_CA=
# Read replica opcional (TypeORM replication).
# Quando definido, SELECT vai automaticamente para o replica e INSERT/UPDATE/DELETE
# + transações vão para o master. Use connection string completa do replica Neon/RDS.
# Em ambientes single-instance (desenvolvimento), deixar vazio.
DATABASE_REPLICA_URL=
# DATABASE_ADMIN_URL — conexão dedicada para operações cross-tenant privilegiadas
# (LGPD, DR backup, cleanup de audit_logs, tenant-validation sem contexto).
# Role: sgs_admin (LOGIN, membro de sgs_rls_bypass). Endpoint DIRETO (sem pooler).
# Opcional: se ausente, PrivilegedDbService fica dormente e o fallback usa sgs_app
# com SET LOCAL is_super_admin (funciona enquanto sgs_app tiver sgs_rls_bypass).
# OBRIGATÓRIO antes de rodar migration 361 (REVOKE sgs_rls_bypass FROM sgs_app).
# Formato: postgresql://sgs_admin:<senha>@<neon-direct>:5432/<dbname>?sslmode=require
DATABASE_ADMIN_URL=
# Máximo de conexões no pool dedicado (padrão: 3 — operações admin são de baixo volume).
DATABASE_ADMIN_POOL_MAX=3
# Migração controlada (P0 CPF): fallback legado para lookup por users.cpf (plaintext).
# PRODUÇÃO: manter false e rodar o backfill `npm run privacy:cpf:backfill:apply`.
LEGACY_CPF_PLAINTEXT_LOOKUP_ENABLED=false
# Identificação de origem no Postgres (aparece em pg_stat_activity)
DB_APPLICATION_NAME_WEB=api_web
DB_APPLICATION_NAME_WORKER=api_worker
DB_APPLICATION_NAME=

# ---------------------------------
# Cache & Queue (Redis) Configuration
# ---------------------------------
# Produção: prefira quatro URLs externas distintas (Redis Cloud/Upstash/etc).
# Se você tiver menos instâncias, os tiers ainda aceitam fallback genérico.
# O runtime usa AUTH, RATE_LIMIT, CACHE e QUEUE como tiers independentes.
# REDIS_URL pode permanecer apenas para compatibilidade legada com scripts.
REDIS_AUTH_URL=
REDIS_RATE_LIMIT_URL=
REDIS_CACHE_URL=
REDIS_QUEUE_URL=
# Alternativa às URLs: configuração separada por tier.
REDIS_AUTH_HOST=
REDIS_AUTH_PORT=6379
REDIS_AUTH_USERNAME=
REDIS_AUTH_PASSWORD=
REDIS_RATE_LIMIT_HOST=
REDIS_RATE_LIMIT_PORT=6379
REDIS_RATE_LIMIT_USERNAME=
REDIS_RATE_LIMIT_PASSWORD=
REDIS_CACHE_HOST=
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=
REDIS_CACHE_PASSWORD=
REDIS_QUEUE_HOST=
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_USERNAME=
REDIS_QUEUE_PASSWORD=
REDIS_URL=
REDIS_TLS=false
# Em produção, prefira URLs rediss://. As flags abaixo existem para provedores
# que entregam URL redis:// junto de uma porta TLS dedicada.
REDIS_AUTH_TLS=false
REDIS_RATE_LIMIT_TLS=false
REDIS_CACHE_TLS=false
REDIS_QUEUE_TLS=false
# Opção genérica legada.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis hardening / emergency mode
# - REDIS_DISABLED=true: modo degradado (não recomendado para produção)
# - REDIS_FAIL_OPEN=true: permite fallback em memória quando Redis não conecta (apenas dev por padrão)
# - REDIS_ALLOW_IN_MEMORY_FALLBACK_IN_PROD=true: libera explicitamente fallback em produção (modo emergencial)
REDIS_DISABLED=false
REDIS_FAIL_OPEN=false
REDIS_ALLOW_IN_MEMORY_FALLBACK_IN_PROD=false

# ---------------------------------
# Bull Board (filas) — Hardening
# ---------------------------------
# Para habilitar /admin/queues, configure uma senha (Basic Auth).
# Observação: a rota só aceita acesso via localhost.
BULL_BOARD_USER=admin
BULL_BOARD_PASS=
ALERTS_DLQ_COOLDOWN_MS=900000
AI_RECOVERY_MAX_AGE_MS=86400000
# Idempotência autenticada: retenção curta, resposta limitada e quota por usuário/tenant.
IDEMPOTENCY_TTL_SECONDS=3600
IDEMPOTENCY_MAX_RESPONSE_BYTES=65536
IDEMPOTENCY_MAX_KEYS_PER_SCOPE=100

# ---------------------------------
# Antivírus (ClamAV)
# ---------------------------------
# PRODUÇÃO: OBRIGATÓRIO. Sem ANTIVIRUS_PROVIDER configurado, uploads são bloqueados
# com ServiceUnavailableException (fail-closed). Instale o ClamAV e aponte o socket.
# Valores suportados: clamav
ANTIVIRUS_PROVIDER=
# PRODUÇÃO: ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ---------------------------------
# S3-Compatible Storage Configuration
# ---------------------------------
AWS_ACCESS_KEY_ID=
REDACTED
AWS_BUCKET_NAME=
AWS_REGION=auto
AWS_ENDPOINT=
# Set to 'true' if using a local S3-compatible service like MinIO
S3_FORCE_PATH_STYLE=false

# Optional source storage used only to reconcile/migrate already externalized
# signatures into a new bucket. Keep empty unless running
# `npm run signatures:storage:reconcile:*`.
SIGNATURE_STORAGE_SOURCE_BUCKET=
SIGNATURE_STORAGE_SOURCE_ENDPOINT=
SIGNATURE_STORAGE_SOURCE_REGION=auto
SIGNATURE_STORAGE_SOURCE_ACCESS_KEY_ID=
SIGNATURE_STORAGE_SOURCE_SECRET_ACCESS_KEY=
SIGNATURE_STORAGE_SOURCE_FORCE_PATH_STYLE=true

# ---------------------------------
# Secondary Replica Storage (DR)
# ---------------------------------
DR_STORAGE_REPLICA_BUCKET=
DR_STORAGE_REPLICA_ENDPOINT=
DR_STORAGE_REPLICA_REGION=auto
DR_STORAGE_REPLICA_ACCESS_KEY_ID=
DR_STORAGE_REPLICA_SECRET_ACCESS_KEY=
DR_STORAGE_REPLICA_FORCE_PATH_STYLE=true

# ---------------------------------
# Other Services
# ---------------------------------
# ---------------------------------
# AI (SOPHIE) — NVIDIA NIM / GPT-OSS 120B
# ---------------------------------
# Feature flag: desativa completamente endpoints de IA (/ai/* e /sophie/*).
# Valores: true | false
FEATURE_AI_ENABLED=true

# Provedor oficial da SOPHIE: nvidia | openai | stub | local
AI_PROVIDER=nvidia

# NVIDIA NIM Cloud API. Não reutilize OPENAI_API_KEY neste campo.
NVIDIA_API_KEY=
# Endpoint oficial permitido: https://integrate.api.nvidia.com/v1
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-120b
# Opcional; deve ser outro modelo NVIDIA compatível.
NVIDIA_FALLBACK_MODEL=
# Valores aceitos pela NVIDIA para GPT-OSS: low | medium | high
NVIDIA_REASONING_EFFORT=medium

# O GPT-OSS-120B é text-only. A análise de imagens permanece bloqueada até
# existir uma integração separada com modelo visual aprovado.

# Compatibilidade legada com OpenAI (use apenas se AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-2024-11-20
OPENAI_VISION_MODEL=gpt-4o-2024-11-20
OPENAI_FALLBACK_MODEL=gpt-4o-2024-11-20

# Versionamento jurídico: a revisão que inclui NVIDIA NIM exige reaceite do
# consentimento de IA. Mantenha a versão pública de privacidade alinhada.
LEGAL_POLICY_VERSION=2026-07-13
LEGAL_AI_CONSENT_VERSION=2026-07-13

# Resend (prioridade): se RESEND_API_KEY estiver preenchida, o envio usa
# Resend. Caso contrário, cai para SMTP (MAIL_HOST/MAIL_USER/MAIL_PASS).
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=

RESEND_API_KEY=
MAIL_FROM_NAME="GST - Gestão de Segurança do Trabalho"
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_REPLY_TO_NAME="GST - Gestão de Segurança do Trabalho"
MAIL_REPLY_TO_EMAIL=suporte@seudominio.com

# Agendamento de alertas automáticos por e-mail
MAIL_ALERT_SCHEDULE_MIN_INTERVAL_MS=300000
MAIL_ALERT_SCHEDULE_LOCK_TTL_MS=600000
MAIL_ALERT_COMPANY_BATCH_SIZE=10
MAIL_ALERT_COMPANY_MAX_PARALLEL=2

# Heartbeat do processo worker (para /health detectar fila viva)
WORKER_HEARTBEAT_ENABLED=true
WORKER_HEARTBEAT_REQUIRED=false
WORKER_HEARTBEAT_KEY=worker:heartbeat:queue-runtime
WORKER_HEARTBEAT_TTL_SECONDS=90

# ---------------------------------
# Observabilidade (opcional)
# ---------------------------------
# PRODUÇÃO: usar warn ou error. debug expõe dados sensíveis em logs.
LOG_LEVEL=warn
OTEL_ENABLED=false
OTEL_SERVICE_NAME=wanderson-gandra-backend
OTEL_SERVICE_VERSION=1.0.0
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PORT=9464
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT_MS=5000
NEW_RELIC_ENABLED=false
PERF_PROFILING_ENABLED=false
PERF_PROFILING_SAMPLE_RATE=0.2
# Obrigatório quando NEW_RELIC_ENABLED=true (obtenha em one.newrelic.com → API keys)
NEW_RELIC_LICENSE_KEY=
# Nome exibido no painel New Relic (sobrescreve app_name em newrelic.js)
NEW_RELIC_APP_NAME=wanderson-gandra-backend

# ---------------------------------
# PgBouncer (produção)
# ---------------------------------
# SECURITY: transaction pooling para apps stateless (NestJS)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=5432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=20

# Dica: ao usar PgBouncer, a API deve apontar para o PgBouncer.
# Configure DATABASE_URL no provedor com credenciais próprias; não versionar connection string.
# Em Railway: use o endpoint de PgBouncer fornecido pelo provedor (porta 5432)
# SECURITY: prepared statements não funcionam com POOL_MODE=transaction
# Compatibilidade já habilitada via app.module.ts (extra.prepareThreshold=0)

# ---------------------------------
# DEV LOGIN BYPASS (somente desenvolvimento)
# ---------------------------------
# Quando DEV_LOGIN_BYPASS=true, permite login sem DB (credenciais abaixo).
# Use apenas para destravar UI quando o banco estiver indisponível.
DEV_ADMIN_CPF=15082302698
DEV_ADMIN_PASSWORD=change-me-dev-only
DEV_LOGIN_BYPASS=false

# Desabilita throttle de login em DEV de forma explícita (não use em ambientes expostos)
DISABLE_LOGIN_THROTTLE_IN_DEV=false

# Proteção anti brute force (por IP) no endpoint /auth/login
LOGIN_FAIL_MAX=10
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_FAIL_BLOCK_SECONDS=900
# Proteção de bloqueio por conta (CPF) para ataques distribuídos
LOGIN_FAIL_ACCOUNT_MAX=10
LOGIN_FAIL_ACCOUNT_BLOCK_SECONDS=900

# Multi-tenant hardening:
# Quando true, ADMIN_GERAL só acessa rotas tenant-scoped se enviar `x-company-id`.
# Rotas globais devem ser anotadas com @TenantOptional().
# PRODUÇÃO: definir true para evitar operação inadvertida sem tenant selecionado.
REQUIRE_EXPLICIT_TENANT_FOR_SUPER_ADMIN=false
# PRODUÇÃO: REQUIRE_EXPLICIT_TENANT_FOR_SUPER_ADMIN=true

# ---------------------------------
# Public validation hardening (faseado)
# ---------------------------------
# Segredo para assinar token opaco de validação pública de documentos.
VALIDATION_TOKEN_SECRET=CHANGE_THIS_TO_A_DIFFERENT_32_CHAR_SECRET
# Compatibilidade temporária com contrato legado (code-only). Desativar após migração.
PUBLIC_VALIDATION_LEGACY_COMPAT=false
PUBLIC_VALIDATION_LOG_CONTRACT_USAGE=true

# ---------------------------------
# Refresh hardening (CSRF + rate limit)
# ---------------------------------
REFRESH_THROTTLE_LIMIT=20
REFRESH_THROTTLE_TTL=60000
# Padrão endurecido: bloquear violações em vez de apenas reportar.
REFRESH_CSRF_REPORT_ONLY=false
REFRESH_CSRF_ENFORCED=true

# Quando true, se o throttler Redis falhar em /auth/login, /auth/refresh ou /auth/me,
# o backend responde erro (fail-closed) em vez de liberar requisição.
THROTTLER_FAIL_CLOSED_AUTH_ROUTES=true
# Em falha/timeout do storage Redis do throttler:
# - true  => fail-open (continua sem bloquear)
# - false => propaga erro para o guard decidir fallback/503.
# Recomendado em produção: false (mais previsível e auditável).
THROTTLER_STORAGE_FAIL_OPEN=false
# Timeout dedicado para o storage Redis do throttler (ms).
# Evita pendurar request no Redis em cenários de instabilidade.
THROTTLER_STORAGE_REDIS_TIMEOUT_MS=200
# Fallback local para autenticação quando o throttler Redis está indisponível.
# Mantém proteção básica sem transformar indisponibilidade de Redis em 503 em massa.
THROTTLER_AUTH_LOCAL_FALLBACK_ENABLED=true
THROTTLER_AUTH_LOCAL_FALLBACK_LIMIT=60
THROTTLER_AUTH_LOCAL_FALLBACK_TTL_MS=60000
# /auth/me recebe limite próprio no fallback local para não estrangular o fluxo
# de sessão em cenários de oscilação temporária do Redis.
THROTTLER_AUTH_ME_LOCAL_FALLBACK_LIMIT=1200
THROTTLER_AUTH_ME_LOCAL_FALLBACK_TTL_MS=60000
# Timeout máximo para decisão do throttler Redis antes de cair no fallback local.
THROTTLER_DECISION_TIMEOUT_MS=250
# Cooldown de log para evitar spam quando fallback está ativo sob carga (ms).
THROTTLER_AUTH_FALLBACK_LOG_COOLDOWN_MS=15000

# Observabilidade de rollout
SECURITY_HARDENING_PHASE=phase0

# ---------------------------------
# Auth performance (cache curto)
# ---------------------------------
RBAC_ACCESS_CACHE_TTL_SECONDS=120
AUTH_SESSION_USER_CACHE_TTL_SECONDS=45
AUTH_PROFILE_NAME_CACHE_TTL_SECONDS=300
# Limite de sessões refresh ativas por usuário.
# Valor maior reduz churn/evictions em cenários de múltiplos logins concorrentes.
MAX_ACTIVE_SESSIONS_PER_USER=10

# ---------------------------------
# Rate Limiting (Resilient Throttler) — PR #4
# ---------------------------------
# Ativar/desativar sistema inteiro de rate limiting
THROTTLER_ENABLED=true
# Falhar fechado em rotas críticas quando Redis offline
THROTTLER_FAIL_CLOSED=true

# Limites por tipo de rota (requisições / minuto)
THROTTLER_AUTH_LIMIT=5              # POST /auth/login
THROTTLER_PUBLIC_LIMIT=10            # /validate, /public/* routes
THROTTLER_API_LIMIT=100              # /api/* routes
THROTTLER_DASHBOARD_LIMIT=50         # /dashboard/* routes

# Comprimento da janela de limite (em ms)
THROTTLER_WINDOW_MS=60000            # 60 segundos

# ---------------------------------
# CSRF Protection — PR #5
# ---------------------------------
# Ativar proteção CSRF
REFRESH_CSRF_ENFORCED=true
# Modo report-only (log violations sem bloquear)
REFRESH_CSRF_REPORT_ONLY=false
# Segredo para assinar tokens CSRF (mínimo 32 caracteres)
CSRF_TOKEN_SECRET=CHANGE_THIS_TO_A_DIFFERENT_32_CHAR_SECRET
# TTL do token CSRF em segundos
CSRF_TOKEN_TTL_SECONDS=3600

# ---------------------------------
# Dashboard Cache — PR #6
# ---------------------------------
# Ativar/desativar cache de dashboard
DASHBOARD_CACHE_ENABLED=true

# TTL para diferentes tipos de cache (em segundos)
DASHBOARD_CACHE_TTL_METRICS=300       # 5 minutos (dashboard KPIs)
DASHBOARD_CACHE_TTL_ACTIVITIES=60     # 1 minuto (activity feed)
DASHBOARD_CACHE_TTL_SUMMARIES=3600    # 1 hora (résumés mensais)

# ---------------------------------
# N+1 Query Detection — PR #7 (Dev tool)
# ---------------------------------
# Ativar detecção de padrões N+1 (apenas desenvolvimento)
N1_QUERY_DETECTION_ENABLED=false
# Limiar de repetições para alertar sobre N+1
N1_QUERY_THRESHOLD=3
# Limiar de latência para reportar queries lentas (ms)
N1_SLOW_QUERY_THRESHOLD=100
