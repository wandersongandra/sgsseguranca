{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node ./scripts/check-node.js && node ./scripts/check-required-env.mjs dev",
    "build": "node ./scripts/run-next-build.cjs",
    "prebuild": "node ./scripts/check-node.js && node ./scripts/check-required-env.mjs build",
    "prestart": "node ./scripts/check-required-env.mjs start",
    "start": "next start",
    "api:generate:document-import": "node ../ops/frontend/scripts/generate-document-import-client.mjs",
    "api:generate:governed-contracts": "node ../ops/frontend/scripts/generate-governed-contracts-client.mjs",
    "lint": "npm run check:permission-imports && node ../ops/frontend/scripts/run-eslint.cjs && npm run lint:styles",
    "check:permission-imports": "node ../ops/frontend/scripts/check-permission-imports.cjs",
    "test:permission-imports": "node ../ops/frontend/scripts/test-add-permission-imports.cjs",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "test": "node ../ops/frontend/scripts/run-jest.cjs --config jest.config.cjs --runInBand --no-cache",
    "test:ci": "node ../ops/frontend/scripts/run-jest.cjs --ci --runInBand --config jest.config.cjs --no-cache",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test e2e/public-mobile.spec.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.70.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-signature-canvas": "^1.0.7",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.33.0",
    "next": "^16.3.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild-register": "^3.6.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lightningcss": "^1.33.0",
    "openapi-typescript": "^7.13.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "tailwindcss": "^4.2.1"
  },
  "overrides": {
    "browserslist": "4.28.8",
    "brace-expansion": "^5.0.8",
    "ws": "^8.21.0",
    "postcss": "^8.5.22",
    "form-data": "^4.0.6",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "sharp": ">=0.35.0",
    "fast-uri": "^3.1.6"
  }
}
