# Copie para .env.loadtest no host de teste. Este arquivo nunca deve receber
# credenciais reais de produção e não deve ser commitado com valores preenchidos.
APP_ENV=loadtest
LOADTEST_PROXY_KEY=REDACTED
LOADTEST_BIND_PORT=8088

POSTGRES_MIGRATOR_USER=sgs_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_SYNTHETIC_ONLY
POSTGRES_APP_PASSWORD=CHANGE_ME_SYNTHETIC_ONLY
REDIS_PASSWORD=CHANGE_ME_SYNTHETIC_ONLY

JWT_SECRET=CHANGE_ME_GENERATE_ON_VPS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ON_VPS
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_ON_VPS
FIELD_ENCRYPTION_HASH_KEY=CHANGE_ME_GENERATE_ON_VPS
MFA_TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_ON_VPS

# Usuário fictício determinístico do ambiente; nunca reutilize credenciais reais.
LOADTEST_ADMIN_CPF=00000000001
LOADTEST_ADMIN_PASSWORD=CHANGE_ME_SYNTHETIC_ONLY
LOADTEST_COMPANY_ID=00000000-0000-4000-8000-000000000001
LOADTEST_SITE_ID=00000000-0000-4000-8000-000000000002
LOADTEST_USER_ID=00000000-0000-4000-8000-000000000003

# Limites padrão do perfil geral. Ajuste após medir RAM/CPU da VPS.
LOADTEST_API_MEMORY_LIMIT=768m
LOADTEST_POSTGRES_MEMORY_LIMIT=384m
LOADTEST_REDIS_MEMORY_LIMIT=128m
LOADTEST_REDIS_MAXMEMORY=96mb
LOADTEST_PROXY_MEMORY_LIMIT=128m
LOADTEST_NODE_HEAP_MB=512
LOADTEST_DB_POOL_MAX=6
